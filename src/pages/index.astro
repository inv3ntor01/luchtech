<!-- HERO SECTION WITH MINIATURE THREE.JS 3D FLOATING CUBES -->
<section class="relative w-full pt-16 pb-20 md:pt-24 md:pb-28 overflow-hidden" id="hero">
<!-- Three.js Canvas Container for Floating Brand Cubes -->
<div class="absolute inset-0 w-full h-full pointer-events-none z-0 overflow-hidden" id="hero-3d-bg">
<div class="w-full h-full" id="threejs-container-ANIMATION_17"><canvas height="1492" style="display: block; width: 1280px; height: 1194px;" width="1600"></canvas><canvas width="1600" height="1492" style="display: block; width: 1280px; height: 1194px;"></canvas><canvas width="1600" height="1447" style="display: block; width: 1280px; height: 1158px;"></canvas></div>
</div>
<script src="https://ajax.googleapis.com/ajax/libs/threejs/r125/three.min.js"></script>
<script>
(function() {
  const container = document.getElementById('threejs-container-ANIMATION_17');
  if (!container) return;
  const width = container.clientWidth || window.innerWidth;
  const height = container.clientHeight || window.innerHeight;

  const scene = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(40, width / height, 0.1, 1000);
  camera.position.set(0, 0, 24);

  const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
  renderer.setSize(width, height);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  container.appendChild(renderer.domElement);

  const ambientLight = new THREE.AmbientLight(0xffffff, 0.6);
  scene.add(ambientLight);

  const dirLight1 = new THREE.DirectionalLight(0x38bdf8, 1.4);
  dirLight1.position.set(12, 16, 10);
  scene.add(dirLight1);

  const dirLight2 = new THREE.DirectionalLight(0xf95738, 1.3);
  dirLight2.position.set(-12, -10, 8);
  scene.add(dirLight2);

  const logoColors = [0x2563eb, 0x38bdf8, 0xa855f7, 0xf95738, 0x60a5fa];
  const cubeGroup = new THREE.Group();
  cubeGroup.position.set(7.5, 0, 0);
  scene.add(cubeGroup);

  const cubes = [];
  const cubeCount = 18;
  const baseGeometry = new THREE.BoxGeometry(0.65, 0.65, 0.65);
  const wireGeometry = new THREE.EdgesGeometry(baseGeometry);

  for (let i = 0; i < cubeCount; i++) {
    const color = logoColors[i % logoColors.length];
    const material = new THREE.MeshPhongMaterial({
      color: color,
      specular: 0xffffff,
      shininess: 30,
      transparent: true,
      opacity: 0.7,
      flatShading: true
    });

    const mesh = new THREE.Mesh(baseGeometry, material);
    const wireMaterial = new THREE.LineBasicMaterial({
      color: 0xffffff,
      transparent: true,
      opacity: 0.25,
      linewidth: 1
    });
    mesh.add(new THREE.LineSegments(wireGeometry, wireMaterial));

    const y = (i - (cubeCount / 2)) * 1.35 + (Math.random() - 0.5) * 0.8;
    const x = (Math.random() - 0.5) * 3.2;
    const z = (Math.random() - 0.5) * 3.5;
    mesh.position.set(x, y, z);
    mesh.rotation.x = Math.PI / 6 + (Math.random() - 0.5) * 0.4;
    mesh.rotation.y = Math.PI / 4 + (Math.random() - 0.5) * 0.4;
    mesh.rotation.z = (Math.random() - 0.5) * 0.3;

    const scale = 0.5 + Math.random() * 0.5;
    mesh.scale.set(scale, scale, scale);

    cubes.push({
      mesh,
      basePos: { x, y, z },
      rotSpeed: {
        x: (Math.random() - 0.5) * 0.004,
        y: (Math.random() - 0.5) * 0.005,
        z: (Math.random() - 0.5) * 0.003
      },
      floatSpeed: 0.5 + Math.random() * 0.5,
      floatOffset: Math.random() * Math.PI * 2,
      amplitude: 0.18 + Math.random() * 0.22
    });

    cubeGroup.add(mesh);
  }

  let mouseX = 0, mouseY = 0, targetX = 0, targetY = 0;
  window.addEventListener('mousemove', (e) => {
    mouseX = (e.clientX / window.innerWidth) * 2 - 1;
    mouseY = -(e.clientY / window.innerHeight) * 2 + 1;
  }, { passive: true });

  window.addEventListener('resize', () => {
    const w = container.clientWidth || window.innerWidth;
    const h = container.clientHeight || window.innerHeight;
    camera.aspect = w / h;
    camera.updateProjectionMatrix();
    renderer.setSize(w, h);
  });

  const clock = new THREE.Clock();
  function animate() {
    requestAnimationFrame(animate);
    const elapsed = clock.getElapsedTime();
    targetX += (mouseX * 0.6 - targetX) * 0.03;
    targetY += (mouseY * 0.6 - targetY) * 0.03;
    cubeGroup.rotation.y = targetX * 0.25;
    cubeGroup.rotation.x = -targetY * 0.2;

    for (let i = 0; i < cubes.length; i++) {
      const it = cubes[i];
      it.mesh.rotation.x += it.rotSpeed.x;
      it.mesh.rotation.y += it.rotSpeed.y;
      it.mesh.rotation.z += it.rotSpeed.z;
      it.mesh.position.y = it.basePos.y + Math.sin(elapsed * it.floatSpeed + it.floatOffset) * it.amplitude;
      it.mesh.position.x = it.basePos.x + Math.cos(elapsed * it.floatSpeed * 0.5 + it.floatOffset) * 0.12;
    }
    renderer.render(scene, camera);
  }
  animate();
})();
</script>
